{
  "manifestVersion": 5,
  "id": "it.tommasoscicchitano.prova",
  "name": "Prova di caricamento",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "pannelloProva",
      "label": { "default": "Prova di caricamento" },
      "minimumSize": { "width": 200, "height": 120 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 240, "height": 160 },
      "preferredFloatingSize": { "width": 240, "height": 160 }
    }
  ]
}

{
  "manifestVersion": 5,
  "id": "it.tommasoscicchitano.cameraoscura",
  "name": "Camera Oscura BN",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "27.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "cameraOscuraPanel",
      "label": {
        "default": "Camera Oscura BN"
      },
      "minimumSize": {
        "width": 300,
        "height": 360
      },
      "maximumSize": {
        "width": 2400,
        "height": 2400
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 900
      },
      "preferredFloatingSize": {
        "width": 400,
        "height": 900
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}

   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Infrarosso 400</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Camera Oscura BN</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Con filtro infrarosso: fogliame bianco, cielo nero, alone luminoso. Vale la pena solo se nella scena c'e verde vivo.</rdf:li>
    </rdf:Alt>
   </crs:Description>

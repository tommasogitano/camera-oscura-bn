   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Notte, interni, concerti. Grana grossa e presente, neri che non arrivano mai davvero al nero: e proprio quello il suo fascino.</rdf:li>
    </rdf:Alt>
   </crs:Description>

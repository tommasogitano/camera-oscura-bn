   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Scala lunga e delicata, neri caldi che non chiudono mai del tutto: la resa delle stampe al platino-palladio.</rdf:li>
    </rdf:Alt>
   </crs:Description>

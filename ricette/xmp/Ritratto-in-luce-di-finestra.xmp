   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Incarnati chiari e morbidi, ombre aperte, nessuna durezza sulla pelle. Il filtro verde tiene le labbra dove devono stare.</rdf:li>
    </rdf:Alt>

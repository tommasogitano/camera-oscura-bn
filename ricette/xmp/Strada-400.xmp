   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">La pellicola del reportage: neri pieni, mezzitoni robusti, grana disegnata e ben visibile. Perdona l'esposizione approssimativa.</rdf:li>
    </rdf:Alt>

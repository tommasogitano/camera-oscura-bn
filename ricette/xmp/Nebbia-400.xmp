   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Cugina inglese della Strada 400, piu gentile nelle ombre e piu lunga nelle luci: ottima con la luce dura del mezzogiorno.</rdf:li>
    </rdf:Alt>
